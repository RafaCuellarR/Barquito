<launch>
  <!-- 1. Nodo del Driver de la Amcrest (Los parámetros se leen internamente en Python) -->
  <node pkg="amcrest_jetson_driver" exec="amcrest_node" name="jetson_amcrest_driver" output="screen">
    <param name="ip_camara" value="172.16.5.182" />
    <param name="usuario" value="admin" />
    <param name="contrasena" value="cdmit2026" />
  </node>

  <!-- 2. Publicador de Transformación Estática -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="camera_static_tf"
        args="--x 0 --y 0 --z 0 --yaw 0 --pitch 0 --roll 0 --frame-id map --child-frame-id camera_link_optical" />
</launch>
